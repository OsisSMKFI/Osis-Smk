{
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/admin/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/enroll/upload-photo/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/attendance/upload-selfie/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "github": {
    "autoAlias": true,
    "silent": false,
    "autoJobCancelation": false
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/data/members",
      "destination": "/admin/members"
    },
    {
      "source": "/admin/data/sekbid",
      "destination": "/admin/sekbid"
    }
  ]
}
