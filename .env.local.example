# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Member Photo Upload Bucket (optional, defaults to 'gallery')
# Create this bucket in Supabase Storage and set public policy
NEXT_PUBLIC_MEMBER_BUCKET=members

# ==========================================
# VERCEL SERVICES
# ==========================================

# Vercel AI Gateway (100+ AI models)
# Get from: https://vercel.com/dashboard > AI Gateway
VERCEL_AI_API_KEY=vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Edge Config
# Get from: https://vercel.com/dashboard > Storage > Edge Config
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxxxxxx?token=xxxxx

# Vercel Blob Store
# Get from: https://vercel.com/dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxx

# Turso Database (SQLite)
# Get from: https://vercel.com/dashboard > Storage > Turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ==========================================

# Social Media API Keys (optional)
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI Chat (optional)
GEMINI_API_KEY=
NEXT_PUBLIC_DISABLE_CHAT=0

# Login Rate Limiting (optional)
LOGIN_MAX_ATTEMPTS=5
NEXTAUTH_SESSION_MAX_AGE=28800

# Email (optional, for notifications)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
